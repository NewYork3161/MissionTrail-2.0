
// ======================================================
// ONBOARDING CHECK ID
// ======================================================
//
// FILE:
//
// src/app/onboarding_check_id.tsx
//
// PURPOSE:
//
// Allows the user to:
//
// 1. Upload the FRONT of their ID
// 2. Take a photo of the FRONT of their ID
// 3. Preview the image
// 4. Send the image + onboarding information to
//    onboarding_ai_check_id_authentication.ts
// 5. Display the verification result
//
// ======================================================

import React, { useState } from 'react';

import {
  View,
  Text,
  TouchableOpacity,
  StyleSheet,
  ScrollView,
  Image,
  Alert,
  Platform,
  ActivityIndicator,
} from 'react-native';

import { Ionicons } from '@expo/vector-icons';

import {
  router,
  useLocalSearchParams,
} from 'expo-router';

import * as ImagePicker from 'expo-image-picker';


// ======================================================
// AI AUTHENTICATION SERVICE
// ======================================================

import {
  verifyOnboardingId,
  didIdentityInformationMatch,
  identityNeedsManualReview,
  getIdentityVerificationMessage,
  IdVerificationResult,
} from '../services/onboarding_ai_check_id_authentication';

import {
  saveOnboardingVerificationTicket,
} from '@/services/onboarding-verification-ticket-service';



// ======================================================
// SCREEN
// ======================================================

// Purpose: Guides the user through selecting and verifying a photo ID.
export default function OnboardingCheckId() {

  // ====================================================
  // RECEIVE USER INFORMATION
  // ====================================================

  const params = useLocalSearchParams<{
    firstName?: string;
    lastName?: string;
    displayName?: string;
    birthday?: string;
    city?: string;
    state?: string;
    country?: string;
    questionnaireAnswers?: string;
  }>();


  const firstName =
    typeof params.firstName === 'string'
      ? params.firstName
      : '';


  const lastName =
    typeof params.lastName === 'string'
      ? params.lastName
      : '';


  const displayName =
    typeof params.displayName === 'string'
      ? params.displayName
      : '';


  const birthday =
    typeof params.birthday === 'string'
      ? params.birthday
      : '';


  const city =
    typeof params.city === 'string'
      ? params.city
      : '';


  const state =
    typeof params.state === 'string'
      ? params.state
      : '';


  const country =
    typeof params.country === 'string'
      ? params.country
      : '';


  const questionnaireAnswers =
    typeof params.questionnaireAnswers === 'string'
      ? params.questionnaireAnswers
      : '{}';


  // ====================================================
  // STATE
  // ====================================================

  const [idImage, setIdImage] =
    useState<string | null>(
      null
    );


  const [verifying, setVerifying] =
    useState(false);


  const [
    verificationResult,
    setVerificationResult,
  ] =
    useState<IdVerificationResult | null>(
      null
    );


  // ====================================================
  // CLEAR PREVIOUS VERIFICATION
  // ====================================================

  // Purpose: Clears an old verification result before the ID image changes.
  const clearVerificationResult = () => {
    setVerificationResult(null);
  };


  // ====================================================
  // SHOW MESSAGE
  // ====================================================

  // Purpose: Shows an onboarding message using the platform alert dialog.
  const showMessage = (
    title: string,
    message: string
  ) => {

    if (
      Platform.OS === 'web' &&
      typeof window !== 'undefined'
    ) {
      window.alert(`${title}\n\n${message}`);
      return;
    }

    Alert.alert(title, message);
  };


  // ====================================================
  // SELECT ID FROM DEVICE
  // ====================================================
  //
  // IMPORTANT FOR EXPO WEB:
  // Browsers do not need React Native media-library
  // permission before opening the file chooser. Asking for
  // that permission first can prevent the picker from ever
  // opening. On web we launch the picker directly.
  //
  // ====================================================

  // Purpose: Lets the user choose an ID image from the device library.
  const selectIdImage = async () => {

    if (verifying) {
      return;
    }

    console.log('[CHECK ID] Upload ID Image pressed.');

    try {

      if (Platform.OS !== 'web') {

        const permission =
          await ImagePicker.requestMediaLibraryPermissionsAsync();

        if (!permission.granted) {
          showMessage(
            'Photo Permission Required',
            'MissionTrail needs permission to access your photos so you can select the front of your ID.'
          );
          return;
        }
      }

      const result =
        await ImagePicker.launchImageLibraryAsync({
          mediaTypes: ['images'],
          allowsEditing: false,
          quality: 0.9,
        });

      console.log('[CHECK ID] Image picker result:', result);

      if (result.canceled) {
        return;
      }

      const image = result.assets?.[0];

      if (!image?.uri) {
        showMessage(
          'Unable to Read Image',
          'Please select another image of your ID.'
        );
        return;
      }

      clearVerificationResult();
      setIdImage(image.uri);

      console.log('[CHECK ID] ID image selected successfully.');

    } catch (error) {

      console.error(
        '[CHECK ID] Error selecting ID image:',
        error
      );

      showMessage(
        'Unable to Select Image',
        'Something went wrong while selecting your ID image.'
      );
    }
  };


  // ====================================================
  // TAKE ID PHOTO
  // ====================================================
  //
  // Native Android/iOS uses Expo Camera through
  // launchCameraAsync(). On web, browser camera support for
  // launchCameraAsync can vary. We try it directly so the
  // browser can request camera access itself. If the browser
  // cannot launch a camera, the user can still use Upload ID
  // Image, which opens the desktop/device file chooser.
  //
  // ====================================================

  // Purpose: Opens the camera so the user can photograph an ID.
  const takeIdPhoto = async () => {

    if (verifying) {
      return;
    }

    console.log('[CHECK ID] Take a Picture pressed.');

    try {

      if (Platform.OS !== 'web') {

        const permission =
          await ImagePicker.requestCameraPermissionsAsync();

        if (!permission.granted) {
          showMessage(
            'Camera Permission Required',
            'MissionTrail needs camera access so you can photograph the front of your ID.'
          );
          return;
        }
      }

      const result =
        await ImagePicker.launchCameraAsync({
          mediaTypes: ['images'],
          allowsEditing: false,
          quality: 0.9,
        });

      console.log('[CHECK ID] Camera result:', result);

      if (result.canceled) {
        return;
      }

      const image = result.assets?.[0];

      if (!image?.uri) {
        showMessage(
          'Unable to Read Photo',
          'Please take another photo of your ID.'
        );
        return;
      }

      clearVerificationResult();
      setIdImage(image.uri);

      console.log('[CHECK ID] ID photo captured successfully.');

    } catch (error) {

      console.error(
        '[CHECK ID] Error taking ID photo:',
        error
      );

      if (Platform.OS === 'web') {
        showMessage(
          'Camera Could Not Open',
          'Your browser could not open the camera. You can use Upload ID Image to choose a photo from your computer instead.'
        );
        return;
      }

      showMessage(
        'Camera Error',
        'We could not access the camera. Please try again.'
      );
    }
  };


  // ====================================================
  // REMOVE SELECTED ID
  // ====================================================

  // Purpose: Removes the selected ID image and resets its verification state.
  const removeIdImage = () => {

    if (verifying) {
      return;
    }


    setIdImage(null);

    clearVerificationResult();
  };


  // ====================================================
  // CHECK REQUIRED ONBOARDING INFORMATION
  // ====================================================

  // Purpose: Checks that the required identity details are ready for verification.
  const validateOnboardingInformation =
    (): boolean => {

      if (!firstName.trim()) {

        Alert.alert(
          'First Name Required',
          'Please go back and enter your first name before verifying your ID.'
        );

        return false;
      }


      if (!lastName.trim()) {

        Alert.alert(
          'Last Name Required',
          'Please go back and enter your last name before verifying your ID.'
        );

        return false;
      }


      if (!birthday.trim()) {

        Alert.alert(
          'Birthday Required',
          'Please go back and enter your date of birth before verifying your ID.'
        );

        return false;
      }


      return true;
    };


  // ====================================================
  // VERIFY ID
  // ====================================================

  // Purpose: Submits the ID image and onboarding details for identity verification.
  const verifyId = async () => {

    // --------------------------------------------------
    // PREVENT DOUBLE SUBMISSION
    // --------------------------------------------------

    if (verifying) {
      return;
    }


    // --------------------------------------------------
    // REQUIRE IMAGE
    // --------------------------------------------------

    if (!idImage) {

      Alert.alert(
        'ID Required',
        'Please upload or photograph the front of your ID first.'
      );

      return;
    }


    // --------------------------------------------------
    // REQUIRE ONBOARDING INFORMATION
    // --------------------------------------------------

    if (
      !validateOnboardingInformation()
    ) {
      return;
    }


    try {

      setVerifying(true);

      clearVerificationResult();


      // ==================================================
      // CALL AI AUTHENTICATION SERVICE
      // ==================================================
      //
      // THIS CONNECTS:
      //
      // onboarding_check_id.tsx
      //
      //              ↓
      //
      // onboarding_ai_check_id_authentication.ts
      //
      //              ↓
      //
      // Supabase Edge Function:
      // verify-onboarding-id
      //
      //              ↓
      //
      // OpenAI
      //
      //              ↓
      //
      // user_onboarding database
      //
      // ==================================================

      const result =
        await verifyOnboardingId({
          idImageUri:
            idImage,

          userInformation: {
            firstName:
              firstName.trim(),

            lastName:
              lastName.trim(),

            displayName:
              displayName.trim(),

            birthday:
              birthday.trim(),

            city:
              city.trim(),

            state:
              state.trim(),

            country:
              country.trim(),
          },
        });


      // ==================================================
      // SAVE RESULT TO SCREEN STATE
      // ==================================================

      setVerificationResult(
        result
      );


      // ==================================================
      // SUCCESSFUL MATCH
      // ==================================================

      if (
        didIdentityInformationMatch(
          result
        )
      ) {

        // Purpose:
        // Saves the one-time ticket issued by the trusted
        // verification server before leaving this screen.
        //
        // The ticket is deliberately kept out of
        // Expo Router parameters.
        if (!result.verificationTicket) {

          throw new Error(
            'Secure verification ticket was not returned. Please verify your ID again.'
          );
        }


        await saveOnboardingVerificationTicket(
          result.verificationTicket
        );


        console.log(
          '[CHECK ID] ID information matched. Opening onboarding_success...'
        );

        router.replace({
          pathname: '/onboarding_success',
          params: {
            firstName,
            lastName,
            displayName,
            birthday,
            city,
            state,
            country,

            questionnaireAnswers,

            accountAccessMode:
              'verified',

            idVerificationStatus:
              'verified',
          },
        });

        return;
      }


      // ==================================================
      // MANUAL REVIEW / UNREADABLE
      // ==================================================

      if (
        identityNeedsManualReview(
          result
        )
      ) {

        Alert.alert(
          'Unable to Verify',
          getIdentityVerificationMessage(
            result
          )
        );

        return;
      }


      // ==================================================
      // MISMATCH
      // ==================================================

      if (
        result.status ===
        'mismatch'
      ) {

        Alert.alert(
          'Information Does Not Match',
          getIdentityVerificationMessage(
            result
          )
        );

        return;
      }


      // ==================================================
      // OTHER RESULT
      // ==================================================

      Alert.alert(
        'Verification Result',
        getIdentityVerificationMessage(
          result
        )
      );

    } catch (error: any) {

      console.error(
        'Error verifying ID:',
        error
      );


      const message =
        error?.message ||
        'We could not verify your ID. Please try again.';


      Alert.alert(
        'Verification Error',
        message
      );

    } finally {

      setVerifying(false);
    }
  };


  // ====================================================
  // RESULT APPEARANCE
  // ====================================================

  const verificationMatched =
    verificationResult?.status ===
    'matched';


  const verificationMismatch =
    verificationResult?.status ===
    'mismatch';


  const verificationUnable =
    verificationResult?.status ===
    'unable_to_verify';


  // ====================================================
  // SCREEN
  // ====================================================

  return (

    <ScrollView
      style={styles.container}
      contentContainerStyle={styles.content}
      showsVerticalScrollIndicator={false}
      keyboardShouldPersistTaps="handled"
    >

      {/* ==================================================
          ICON
      ================================================== */}

      <View style={styles.iconCircle}>

        <Ionicons
          name="shield-checkmark-outline"
          size={48}
          color="#63D8FF"
        />

      </View>


      {/* ==================================================
          HEADER
      ================================================== */}

      <Text style={styles.title}>
        Verify Your Identity
      </Text>


      <Text style={styles.subtitle}>
        MissionTrail uses identity verification to help
        protect our community.
      </Text>


      {/* ==================================================
          INFORMATION
      ================================================== */}

      <View style={styles.infoCard}>

        <View style={styles.infoHeader}>

          <Ionicons
            name="id-card-outline"
            size={28}
            color="#63D8FF"
          />


          <Text style={styles.infoTitle}>
            Front of ID Only
          </Text>

        </View>


        <Text style={styles.infoText}>
          Upload a clear image of the front of your
          government-issued photo ID.
        </Text>


        <Text style={styles.infoText}>
          Make sure your name and date of birth are
          clear and readable.
        </Text>


        <Text style={styles.infoText}>
          MissionTrail will compare the readable
          information on the ID with the information
          you entered during onboarding.
        </Text>

      </View>


      {/* ==================================================
          SELECTED ID PREVIEW
      ================================================== */}

      {idImage ? (

        <View style={styles.previewContainer}>

          <Text style={styles.previewTitle}>
            ID Preview
          </Text>


          <Image
            source={{
              uri: idImage,
            }}
            style={styles.previewImage}
            resizeMode="contain"
          />


          <TouchableOpacity
            style={styles.removeButton}
            onPress={removeIdImage}
            activeOpacity={0.8}
            disabled={verifying}
          >

            <Ionicons
              name="trash-outline"
              size={20}
              color="#FF7B8A"
            />


            <Text style={styles.removeButtonText}>
              Remove and Try Again
            </Text>

          </TouchableOpacity>

        </View>

      ) : (

        // ==================================================
        // ID UPLOAD AREA
        // ==================================================

        <View style={styles.uploadArea}>

          <Ionicons
            name="cloud-upload-outline"
            size={54}
            color="#63D8FF"
          />


          <Text style={styles.uploadTitle}>
            Add Your ID
          </Text>


          <Text style={styles.uploadText}>
            Upload an existing image or take a new
            photo of the front of your ID.
          </Text>


          {Platform.OS === 'web' && (

            <Text style={styles.webHint}>
              On a computer, choose an ID image from
              your device.
            </Text>

          )}

        </View>

      )}


      {/* ==================================================
          UPLOAD BUTTON
      ================================================== */}

      <TouchableOpacity
        style={[
          styles.optionButton,
          verifying &&
            styles.optionButtonDisabled,
        ]}
        onPress={selectIdImage}
        activeOpacity={0.8}
        disabled={verifying}
      >

        <Ionicons
          name="images-outline"
          size={26}
          color="#63D8FF"
        />


        <View style={styles.optionTextContainer}>

          <Text style={styles.optionTitle}>
            Upload ID Image
          </Text>


          <Text style={styles.optionSubtitle}>
            Choose the front of your ID from your device
          </Text>

        </View>


        <Ionicons
          name="chevron-forward"
          size={22}
          color="#8C7AA8"
        />

      </TouchableOpacity>


      {/* ==================================================
          CAMERA BUTTON
      ================================================== */}

      <TouchableOpacity
        style={[
          styles.optionButton,
          verifying &&
            styles.optionButtonDisabled,
        ]}
        onPress={takeIdPhoto}
        activeOpacity={0.8}
        disabled={verifying}
      >

        <Ionicons
          name="camera-outline"
          size={26}
          color="#63D8FF"
        />


        <View style={styles.optionTextContainer}>

          <Text style={styles.optionTitle}>
            Take a Picture
          </Text>


          <Text style={styles.optionSubtitle}>
            Photograph the front of your ID
          </Text>

        </View>


        <Ionicons
          name="chevron-forward"
          size={22}
          color="#8C7AA8"
        />

      </TouchableOpacity>


      {/* ==================================================
          VERIFICATION RESULT
      ================================================== */}

      {verificationResult && (

        <View
          style={[
            styles.resultCard,

            verificationMatched &&
              styles.resultCardSuccess,

            verificationMismatch &&
              styles.resultCardMismatch,

            verificationUnable &&
              styles.resultCardReview,
          ]}
        >

          <Ionicons
            name={
              verificationMatched
                ? 'checkmark-circle-outline'
                : verificationMismatch
                ? 'close-circle-outline'
                : 'alert-circle-outline'
            }
            size={30}
            color={
              verificationMatched
                ? '#70E0A0'
                : verificationMismatch
                ? '#FF7B8A'
                : '#FFD166'
            }
          />


          <View style={styles.resultTextContainer}>

            <Text style={styles.resultTitle}>

              {verificationMatched
                ? 'Information Matched'
                : verificationMismatch
                ? 'Information Does Not Match'
                : 'Unable to Verify'}

            </Text>


            <Text style={styles.resultText}>

              {getIdentityVerificationMessage(
                verificationResult
              )}

            </Text>

          </View>

        </View>

      )}


      {/* ==================================================
          VERIFY BUTTON
      ================================================== */}

      <TouchableOpacity
        style={[
          styles.verifyButton,

          (!idImage || verifying) &&
            styles.verifyButtonDisabled,
        ]}
        onPress={verifyId}
        activeOpacity={0.8}
        disabled={
          !idImage ||
          verifying
        }
      >

        {verifying ? (

          <ActivityIndicator
            size="small"
            color="#FFFFFF"
          />

        ) : (

          <Ionicons
            name="shield-checkmark"
            size={23}
            color="#FFFFFF"
          />

        )}


        <Text style={styles.verifyButtonText}>

          {verifying
            ? 'VERIFYING...'
            : verificationMatched
            ? 'VERIFIED'
            : 'VERIFY ID'}

        </Text>

      </TouchableOpacity>


      {/* ==================================================
          PRIVACY NOTICE
      ================================================== */}

      <View style={styles.privacyRow}>

        <Ionicons
          name="lock-closed-outline"
          size={17}
          color="#8C7AA8"
        />


        <Text style={styles.privacyText}>
          Your ID is submitted only for identity
          information verification.
        </Text>

      </View>


      {/* ==================================================
          BACK BUTTON
      ================================================== */}

      <TouchableOpacity
        style={styles.backButton}
        onPress={() =>
          router.back()
        }
        activeOpacity={0.8}
        disabled={verifying}
      >

        <Ionicons
          name="arrow-back-outline"
          size={20}
          color="#B8A7FF"
        />


        <Text style={styles.backButtonText}>
          Back
        </Text>

      </TouchableOpacity>

    </ScrollView>
  );
}


// ======================================================
// STYLES
// ======================================================

const styles =
  StyleSheet.create({

    container: {
      flex: 1,
      backgroundColor: '#05010B',
    },


    content: {
      flexGrow: 1,
      alignItems: 'center',
      paddingHorizontal: 24,
      paddingTop: 55,
      paddingBottom: 60,
    },


    // ==================================================
    // ICON
    // ==================================================

    iconCircle: {
      width: 92,
      height: 92,

      borderRadius: 46,

      alignItems: 'center',
      justifyContent: 'center',

      backgroundColor: '#181028',

      borderWidth: 1,
      borderColor: '#7B42F6',

      marginBottom: 22,
    },


    // ==================================================
    // HEADER
    // ==================================================

    title: {
      color: '#FFFFFF',

      fontSize: 32,

      fontWeight: 'bold',

      textAlign: 'center',

      marginBottom: 10,
    },


    subtitle: {
      maxWidth: 550,

      color: '#B8A7FF',

      fontSize: 16,

      lineHeight: 24,

      textAlign: 'center',

      marginBottom: 28,
    },


    // ==================================================
    // INFO CARD
    // ==================================================

    infoCard: {
      width: '100%',
      maxWidth: 550,

      backgroundColor: '#181028',

      borderWidth: 1,
      borderColor: '#7B42F6',

      borderRadius: 20,

      padding: 20,

      marginBottom: 24,
    },


    infoHeader: {
      flexDirection: 'row',

      alignItems: 'center',

      marginBottom: 14,
    },


    infoTitle: {
      color: '#FFFFFF',

      fontSize: 18,

      fontWeight: '700',

      marginLeft: 10,
    },


    infoText: {
      color: '#C8BED7',

      fontSize: 15,

      lineHeight: 22,

      marginBottom: 9,
    },


    // ==================================================
    // UPLOAD AREA
    // ==================================================

    uploadArea: {
      width: '100%',
      maxWidth: 550,

      minHeight: 210,

      alignItems: 'center',
      justifyContent: 'center',

      backgroundColor: '#12091F',

      borderWidth: 1,

      borderColor: '#7B42F6',

      borderStyle: 'dashed',

      borderRadius: 20,

      padding: 25,

      marginBottom: 20,
    },


    uploadTitle: {
      color: '#FFFFFF',

      fontSize: 20,

      fontWeight: '700',

      marginTop: 12,

      marginBottom: 8,
    },


    uploadText: {
      color: '#B8A7FF',

      fontSize: 14,

      lineHeight: 21,

      textAlign: 'center',

      maxWidth: 400,
    },


    webHint: {
      color: '#8C7AA8',

      fontSize: 13,

      textAlign: 'center',

      marginTop: 10,
    },


    // ==================================================
    // PREVIEW
    // ==================================================

    previewContainer: {
      width: '100%',
      maxWidth: 550,

      backgroundColor: '#12091F',

      borderWidth: 1,
      borderColor: '#7B42F6',

      borderRadius: 20,

      padding: 16,

      marginBottom: 20,
    },


    previewTitle: {
      color: '#FFFFFF',

      fontSize: 17,

      fontWeight: '700',

      marginBottom: 12,
    },


    previewImage: {
      width: '100%',

      height: 280,

      backgroundColor: '#090510',

      borderRadius: 14,
    },


    removeButton: {
      flexDirection: 'row',

      alignItems: 'center',

      justifyContent: 'center',

      marginTop: 14,

      paddingVertical: 10,
    },


    removeButtonText: {
      color: '#FF7B8A',

      fontSize: 14,

      fontWeight: '600',

      marginLeft: 7,
    },


    // ==================================================
    // OPTION BUTTONS
    // ==================================================

    optionButton: {
      width: '100%',
      maxWidth: 550,

      minHeight: 76,

      flexDirection: 'row',

      alignItems: 'center',

      backgroundColor: '#181028',

      borderWidth: 1,

      borderColor: '#7B42F6',

      borderRadius: 18,

      paddingHorizontal: 18,

      marginBottom: 14,
    },


    optionButtonDisabled: {
      opacity: 0.5,
    },


    optionTextContainer: {
      flex: 1,

      marginLeft: 14,
    },


    optionTitle: {
      color: '#FFFFFF',

      fontSize: 16,

      fontWeight: '700',
    },


    optionSubtitle: {
      color: '#9F91B8',

      fontSize: 13,

      lineHeight: 18,

      marginTop: 3,
    },


    // ==================================================
    // RESULT
    // ==================================================

    resultCard: {
      width: '100%',
      maxWidth: 550,

      flexDirection: 'row',

      alignItems: 'flex-start',

      backgroundColor: '#181028',

      borderWidth: 1,

      borderColor: '#7B42F6',

      borderRadius: 18,

      padding: 18,

      marginTop: 4,

      marginBottom: 10,
    },


    resultCardSuccess: {
      borderColor: '#70E0A0',
    },


    resultCardMismatch: {
      borderColor: '#FF7B8A',
    },


    resultCardReview: {
      borderColor: '#FFD166',
    },


    resultTextContainer: {
      flex: 1,

      marginLeft: 12,
    },


    resultTitle: {
      color: '#FFFFFF',

      fontSize: 16,

      fontWeight: '700',

      marginBottom: 5,
    },


    resultText: {
      color: '#C8BED7',

      fontSize: 14,

      lineHeight: 20,
    },


